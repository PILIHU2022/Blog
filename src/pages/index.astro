---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />

  <section class="hero section">
    <div class="hero-profile">
      <img
        class="hero-avatar"
        src={withBase('/images/avatar.webp')}
        alt="Spark 的头像"
        width="88"
        height="88"
      />
      <p class="eyebrow">技术笔记 / 折腾记录</p>
    </div>
    <h1>记录技术、折腾与思考。</h1>
    <p class="lead">
      我是 Spark。这里记录 Arch Linux、Hyprland、Neovim 与自建服务的一些实践笔记，
      也会写下踩过的坑和最后的解法。
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/blog/')}>{t('home.readNotes')}</a>
      <a class="text-link" href={withBase('/about/')}>{t('nav.about')}</a>
      <a class="text-link" href={withBase('/rss.xml')}>RSS</a>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-posts">
    <div class="section-heading">
      <p class="eyebrow">{t('home.latestBlogEyebrow')}</p>
      <h2 id="latest-posts">最近写了什么。</h2>
      <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              <div>
                <p class="meta">
                  {formatDate(post.data.publishDate, 'short')} · {post.data.tags.join(' / ')}
                </p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p set:html={t('home.postsEmpty')} />
        </div>
      )
    }
  </section>

  <section class="section split-overview" aria-label="关于这个博客">
    <div>
      <p class="eyebrow">关于这个博客</p>
      <h2>把踩过的坑，写成能复用的笔记。</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>系统与桌面</h3>
        <p>Arch Linux、Hyprland 与 AMD 显卡的安装、配置和日常维护。</p>
      </article>
      <article>
        <h3>工具与效率</h3>
        <p>Neovim、ruff、Git 与 GPG —— 让开发流程更顺手的一些小工具。</p>
      </article>
      <article>
        <h3>自建与服务</h3>
        <p>博客部署、Cloudflare、Vercel 与 rclone 等自建服务的实践记录。</p>
      </article>
    </div>
  </section>
</BaseLayout>
