---
// Spark's own "about" copy, ported from the old Hugo site. The text is kept as
// written; only the "This site" bullets were updated to the current stack.
//
// Inline links are separated with explicit `{' '}`: Astro trims whitespace at
// line boundaries, so plain newlines around <a> would collapse the spaces.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { SITE } from '../../consts';
import { t } from '../../i18n';
---

<BaseLayout
  title={t('about.title')}
  description={`关于 Spark：自我介绍、兴趣、常用工具与联系方式 — ${SITE.title}。`}
>
  <section class="page-head section">
    <p class="eyebrow">关于</p>
    <h1>Hi 👋</h1>
    <p class="lead">Let me tell you something about me!</p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Intro</p>
      <h2>I'm Spark.</h2>
    </div>
    <div class="prose">
      <p>
        I'm Spark, a senior hight school student who is learning coding with C-lang and Python.{' '}
        <del>A student who want to enter SYSU in the future</del>
      </p>
      <p>
        My code is pushed to GitHub:{' '}
        <a href="https://github.com/PILIHU2022" rel="noopener noreferrer">PILIHU2022</a>{' '}and{' '}
        <a href="https://github.com/PILIHU" rel="noopener noreferrer">PILIHU</a>.
      </p>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Interests</p>
      <h2>Computer &amp; games.</h2>
    </div>
    <div class="prose">
      <h3>Computer</h3>
      <p>Learning coding. Languages:</p>
      <ol>
        <li>C/C++ (Learning)</li>
        <li>Python (Practicing)</li>
      </ol>
      <p>OS:</p>
      <ol>
        <li>
          <a href="https://archlinux.org/" rel="noopener noreferrer">Arch Linux</a>{' '}(with{' '}
          <a href="https://hypr.land/" rel="noopener noreferrer">Hyprland</a>)
        </li>
        <li>Windows (Useless)</li>
      </ol>
      <p>Coding:</p>
      <ol>
        <li><a href="https://neovim.io/" rel="noopener noreferrer">Neovim</a></li>
        <li>
          <a href="https://code.visualstudio.com/" rel="noopener noreferrer">Visual Studio Code</a>
        </li>
      </ol>

      <h3>Games</h3>
      <p><del>Nowadays I feel bored to play any games for no reason 😭</del></p>
      <ol>
        <li><a href="https://www.minecraft.net/" rel="noopener noreferrer">Minecraft</a></li>
        <li><a href="https://store.steampowered.com/" rel="noopener noreferrer">Steam</a></li>
      </ol>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Contact me.</h2>
    </div>
    <div class="prose">
      <p>
        Email me:{' '}
        <a href="mailto:Spark-CN@outlook.com">Spark-CN@outlook.com</a>
      </p>

      <h3>This site</h3>
      <ul>
        <li>
          This website is built with{' '}
          <a href="https://astro.build/" rel="noopener noreferrer">Astro</a>{' '}and the{' '}
          <a href="https://astro.build/themes/details/astro-keel/" rel="noopener noreferrer"
            >Keel</a
          >{' '}theme, deployed on{' '}
          <a href="https://workers.cloudflare.com/" rel="noopener noreferrer">Cloudflare Workers</a
          >.
        </li>
        <li>
          This domain was bought in{' '}
          <a href="https://www.spaceship.com/" rel="noopener noreferrer">Spaceship</a>; nameservers
          on{' '}
          <a href="https://cloudflare.com/" rel="noopener noreferrer">Cloudflare</a>.
        </li>
        <li>
          You can find all the configuration for this blog in{' '}
          <a href="https://github.com/PILIHU2022/Blog" rel="noopener noreferrer"
            >this GitHub repository</a
          >.
        </li>
        <li>
          Thanks for the{' '}
          <a href="https://docs.astro.build/" rel="noopener noreferrer">Astro docs</a>.
        </li>
      </ul>

      <h3>Copyright</h3>
      <p>
        All of the pages are under{' '}
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          rel="license noopener noreferrer">CC BY-NC-SA 4.0</a
        >{' '}Deed.
      </p>
      <p>
        <a
          class="license-badge"
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          rel="license noopener noreferrer"
        >
          <img
            src={withBase('/images/cc-by-nc-sa.png')}
            alt="CC BY-NC-SA 4.0"
            width="88"
            height="31"
            loading="lazy"
            decoding="async"
          />
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
